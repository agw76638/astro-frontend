---
import { getCollection } from 'astro:content';
import BaseHead from '../../components/BaseHead.astro';
import Footer from '../../components/Footer.astro';
import FormattedDate from '../../components/FormattedDate.astro';
import Header from '../../components/Header.astro';
import { SITE_DESCRIPTION, SITE_TITLE } from '../../consts';

const now = new Date();
const posts = (await getCollection("blog"))
	.filter((post) => post.data.pubDate <= now)
	.sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf());
---

<!doctype html>
<html lang="en">
	<head>
		<BaseHead title={`Blog — ${SITE_TITLE}`} description={SITE_DESCRIPTION} />
		<style>
			.blog-body {
				padding-bottom: var(--space-8);
			}
			.post-thumb {
				width: 100%;
				border-radius: var(--radius-sm);
				border: 1px solid var(--line-soft);
				margin-bottom: var(--space-3);
			}
		</style>
	</head>
	<body>
		<Header />
		<main>
			<div class="wrapper">
				<div class="page-head">
					<h1>Blog</h1>
					<p>Notes and posts, newest first.</p>
				</div>
				<div class="blog-body">
					{posts.length > 0 ? (
						<ul class="post-list">
							{
								posts.map((post) => (
									<li>
										<a class="post-row" href={`/blog/${post.id}/`}>
											{post.data.heroImage && (
												<img class="post-thumb" width={720} height={360} src={post.data.heroImage.src} alt="" loading="lazy" />
											)}
											<h3>{post.data.title}</h3>
											<p class="post-meta">
												<FormattedDate date={post.data.pubDate} />
											</p>
											<p class="post-desc">{post.data.description}</p>
										</a>
									</li>
								))
							}
						</ul>
					) : (
						<div class="quiet-empty">
							<p>No posts yet. Check back later.</p>
						</div>
					)}
				</div>
			</div>
		</main>
		<Footer />
	</body>
</html>
