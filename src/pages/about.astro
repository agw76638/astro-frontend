---
import BaseHead from '../components/BaseHead.astro';
import Footer from '../components/Footer.astro';
import Header from '../components/Header.astro';
import { SITE_DESCRIPTION, SITE_TITLE } from '../consts';
---

<!doctype html>
<html lang="en">
	<head>
		<BaseHead title={`About — ${SITE_TITLE}`} description={SITE_DESCRIPTION} />
		<style>
			.about-body {
				padding-bottom: var(--space-8);
			}
			.about-body p {
				color: var(--ink);
				margin-block: var(--space-4);
				max-width: 40rem;
			}
			.about-body p.lead {
				font-size: var(--text-lg);
				color: var(--charcoal);
				line-height: 1.6;
			}
			.facts {
				list-style: none;
				margin: var(--space-8) 0 0;
				padding: var(--space-6) 0 0;
				border-top: 1px solid var(--line);
				display: grid;
				gap: var(--space-4);
			}
			.facts li {
				display: grid;
				grid-template-columns: 8rem 1fr;
				gap: var(--space-4);
				font-size: var(--text-sm);
			}
			.facts dt, .facts .fact-term {
				color: var(--faint);
				font-weight: 700;
				font-size: var(--text-xs);
				letter-spacing: 0.06em;
				text-transform: uppercase;
				padding-top: 0.15em;
			}
			.facts dd, .facts .fact-detail {
				margin: 0;
				color: var(--muted);
			}
			@media (max-width: 560px) {
				.facts li {
					grid-template-columns: 1fr;
					gap: var(--space-1);
				}
			}
		</style>
	</head>
	<body>
		<Header />
		<main>
			<div class="wrapper">
				<div class="page-head">
					<h1>About</h1>
					<p>A short introduction to this site and the person behind it.</p>
				</div>
				<div class="about-body">
					<p class="lead">
						This is the personal site of ahndev — a place for selected work and occasional writing.
					</p>
					<p>
						The portfolio section highlights projects as they are finished. The blog collects
						notes and posts written over time. Both are updated when there is something worth sharing.
					</p>
					<p>
						This page stays intentionally brief for now. More detail will be added over time as
						projects and posts fill in the rest of the site.
					</p>
					<ul class="facts">
						<li>
							<span class="fact-term">Site</span>
							<span class="fact-detail">Portfolio and blog. Built with Astro, published as a static site.</span>
						</li>
						<li>
							<span class="fact-term">Writing</span>
							<span class="fact-detail">Posts live in the <a href="/blog/">blog</a> and are added when ready.</span>
						</li>
						<li>
							<span class="fact-term">Contact</span>
							<span class="fact-detail">Reach out through the links in the footer below.</span>
						</li>
					</ul>
				</div>
			</div>
		</main>
		<Footer />
	</body>
</html>
