---
import { getCollection } from 'astro:content';
import BaseHead from '../components/BaseHead.astro';
import Footer from '../components/Footer.astro';
import FormattedDate from '../components/FormattedDate.astro';
import Header from '../components/Header.astro';
import { PROJECTS, SITE_DESCRIPTION, SITE_TITLE } from '../consts';

const now = new Date();
const recentPosts = (await getCollection("blog"))
	.filter((post) => post.data.pubDate <= now)
	.sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf())
	.slice(0, 3);
---

<!doctype html>
<html lang="en">
	<head>
		<BaseHead title={SITE_TITLE} description={SITE_DESCRIPTION} />
		<style>
			.hero {
				padding-block: var(--space-24) var(--space-16);
				border-bottom: 1px solid var(--line);
			}
			.eyebrow {
				margin: 0 0 var(--space-3);
				font-size: var(--text-xs);
				font-weight: 700;
				letter-spacing: 0.08em;
				text-transform: uppercase;
				color: var(--faint);
			}
			.hero h1 {
				font-size: var(--text-3xl);
				margin: 0 0 var(--space-3);
				letter-spacing: -0.02em;
			}
			.tagline {
				margin: 0;
				color: var(--muted);
				font-size: var(--text-lg);
				max-width: 36rem;
				line-height: 1.6;
			}
			.hero-links {
				display: flex;
				gap: var(--space-4);
				flex-wrap: wrap;
				margin-top: var(--space-6);
				font-size: var(--text-sm);
			}
			.hero-links a {
				text-decoration: none;
			}
			.hero-links a:hover {
				text-decoration: underline;
				text-underline-offset: 3px;
			}
			.section {
				padding-block: var(--space-16) 0;
			}
			.section:last-child {
				padding-bottom: var(--space-8);
			}
			.project-grid {
				display: grid;
				grid-template-columns: repeat(2, 1fr);
				gap: var(--space-4);
				margin-top: var(--space-6);
			}
			.card {
				border: 1px solid var(--line);
				border-radius: var(--radius-md);
				background: var(--bg);
				padding: var(--space-6);
				display: flex;
				flex-direction: column;
				gap: var(--space-2);
				transition: border-color 0.15s ease;
			}
			.card:hover {
				border-color: var(--slate);
			}
			.card img {
				width: 100%;
				border-radius: var(--radius-sm);
				border: 1px solid var(--line-soft);
				margin-bottom: var(--space-2);
			}
			.card h3 {
				margin: 0;
				font-size: var(--text-base);
			}
			.card p {
				margin: 0;
				color: var(--muted);
				font-size: var(--text-sm);
				line-height: 1.65;
			}
			.card a.card-link {
				margin-top: var(--space-2);
				font-size: var(--text-sm);
				text-decoration: none;
				width: fit-content;
			}
			.card a.card-link:hover {
				text-decoration: underline;
				text-underline-offset: 3px;
			}
			@media (max-width: 720px) {
				.hero {
					padding-block: var(--space-16) var(--space-12);
				}
				.hero h1 {
					font-size: var(--text-2xl);
				}
				.tagline {
					font-size: var(--text-base);
				}
				.project-grid {
					grid-template-columns: 1fr;
				}
			}
		</style>
	</head>
	<body>
		<Header />
		<main>
			<div class="wrapper">
				<section class="hero">
					<p class="eyebrow">Portfolio &amp; blog</p>
					<h1>{SITE_TITLE}</h1>
					<p class="tagline">{SITE_DESCRIPTION}</p>
					<div class="hero-links">
						<a href="/blog/">Read the blog &rarr;</a>
						<a href="/about/">About &rarr;</a>
					</div>
				</section>

				{PROJECTS.length > 0 && (
					<section class="section" aria-label="Projects">
						<p class="section-label">Selected work</p>
						<div class="section-head">
							<h2>Projects</h2>
						</div>
						<div class="project-grid">
							{PROJECTS.map((project) => (
								<article class="card">
									{project.image && <img src={project.image} alt="" loading="lazy" />}
									<h3>{project.name}</h3>
									<p>{project.description}</p>
									<a class="card-link" href={project.url}>View project &rarr;</a>
								</article>
							))}
						</div>
					</section>
				)}

				<section class="section" aria-label="Recent posts">
					<p class="section-label">Writing</p>
					<div class="section-head">
						<h2>Recent posts</h2>
						<a class="section-link" href="/blog/">View all &rarr;</a>
					</div>
					{recentPosts.length > 0 ? (
						<ul class="post-list">
							{recentPosts.map((post) => (
								<li>
									<a class="post-row" href={`/blog/${post.id}/`}>
										<h3>{post.data.title}</h3>
										<p class="post-meta">
											<FormattedDate date={post.data.pubDate} />
										</p>
										<p class="post-desc">{post.data.description}</p>
									</a>
								</li>
							))}
						</ul>
					) : (
						<div class="quiet-empty">
							<p>No posts yet. New writing will appear here over time.</p>
						</div>
					)}
				</section>
			</div>
		</main>
		<Footer />
	</body>
</html>
